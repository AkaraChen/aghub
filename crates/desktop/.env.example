# PostHog credentials. Both the webview (Vite) and the Rust binary
# read these — Vite at frontend build time, src-tauri/build.rs at
# Rust compile time. Copy this file to .env and fill in your project
# key. When unset, analytics + logs become silent no-ops.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
