{
	"name": "aghub",
	"type": "module",
	"private": true,
	"workspaces": {
		"catalog": {
			"react": "19.2.7",
			"react-dom": "19.2.7"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "node ./node_modules/@typescript/native/bin/tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"start": "tauri dev",
		"lint": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:dto": "cargo run --manifest-path ../api/Cargo.toml --bin export-dto",
		"typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@heroicons/react": "^2.2.0",
		"@heroui/react": "3.2.2",
		"@heroui/styles": "3.2.2",
		"@lobehub/icons-static-svg": "^1.91.0",
		"@opentelemetry/api-logs": "^0.219.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
		"@opentelemetry/resources": "^2.9.0",
		"@opentelemetry/sdk-logs": "^0.220.0",
		"@tanstack/react-query": "^5.100.14",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-autostart": "2.5.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-deep-link": "^2.4.9",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.3",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"bowser": "2.14.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.0.0",
		"driver.js": "^1.4.0",
		"fuse.js": "^7.4.2",
		"i18next": "^26.3.4",
		"i18next-browser-languagedetector": "^8.2.1",
		"immer": "^11.1.4",
		"ky": "^2.0.0",
		"nuqs": "^2.8.9",
		"pathe": "^2.0.3",
		"pinyin-pro": "^3.28.1",
		"posthog-js": "^1.378.1",
		"react": "catalog:",
		"react-aria-components": "1.19.0",
		"react-dom": "catalog:",
		"react-grab": "^0.1.32",
		"react-hook-form": "^7.79.0",
		"react-i18next": "^17.0.0",
		"react-virtuoso": "^4.18.7",
		"rooks": "^9.8.0",
		"simple-icons": "^16.25.0",
		"stable-hash": "^0.0.6",
		"tailwind-merge": "^3.6.0",
		"wouter": "^3.9.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@eslint-react/eslint-plugin": "^5.14.8",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.2.2",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.1.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.7.0",
		"eslint-plugin-better-tailwindcss": "^4.6.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"knip": "^6.24.0",
		"nano-staged": "^1.0.0",
		"prettier": "^3.9.4",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.1.3"
	},
	"knip": {
		"ignoreDependencies": [
			"react-grab",
			"nano-staged",
			"prettier"
		]
	},
	"nano-staged": {
		"*.{js,ts,jsx,tsx,json,md,css,html}": "prettier --write"
	}
}
